{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/playbook/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/:page(pitch|agency-os|beere-kesava|heaven-gadgets|pharmacy-os|workshop)/:rest*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/:icon(favicon.ico|favicon.svg|favicon-48.png|apple-touch-icon.png|icon-192.png|icon-512.png|site.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "onestop-solutions.vercel.app"
        }
      ],
      "destination": "https://www.onestop-solutions.in/:path*",
      "permanent": true
    },
    {
      "source": "/pharmacyos/pitch",
      "destination": "/pharmacy-os/pitch/",
      "permanent": false
    },
    {
      "source": "/pharmacyos/pitch/",
      "destination": "/pharmacy-os/pitch/",
      "permanent": false
    },
    {
      "source": "/pharmacy-os-pitch",
      "destination": "/pharmacy-os/pitch/",
      "permanent": false
    }
  ]
}
